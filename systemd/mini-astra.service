[Unit]
Description=Mini Astra MPEG-TS service
After=network-online.target
Wants=network-online.target
# Evita tormentas de reinicio (se observaron 400+ en bucle).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/astra-mini /etc/mini-astra/mini-astra.lua
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
User=mini-astra
Group=mini-astra
# Los dispositivos /dev/dvb/* son root:video. Sin esto, abrir el adaptador
# falla con "Permission denied" y el escaneo devuelve cero canales.
SupplementaryGroups=video audio
RuntimeDirectory=mini-astra
WorkingDirectory=/var/lib/mini-astra
Environment=MINI_ASTRA_STATE=/var/lib/mini-astra/streams.json
Environment=MINI_ASTRA_WEB_ROOT=/var/lib/mini-astra/www
# Por defecto solo escucha en local. Para abrirlo a la LAN crear un drop-in:
#   /etc/systemd/system/mini-astra.service.d/20-bind.conf
#   [Service]
#   Environment=MINI_ASTRA_BIND=0.0.0.0
# Sin autenticación: no lo expongas a Internet.
# AF_NETLINK es obligatorio: getifaddrs() lo usa y sin ella el proceso aborta.
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/mini-astra /run/mini-astra
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
